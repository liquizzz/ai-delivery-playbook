#!/usr/bin/env bash
# Secret check (phase 1 setup, checked at gate G1). Blocks a commit when the staged changes
# contain a .env file or a value that looks like a credential.
#
# Install:  cp kit/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Run any time:  bash kit/hooks/pre-commit

set -euo pipefail

status=0

# 1. Real environment files must never be committed (.env.example is allowed).
env_files=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '(^|/)\.env(\.[^/]*)?$' | grep -vE '\.example$' || true)
if [ -n "$env_files" ]; then
  echo "Secret check: environment file(s) staged:"
  echo "$env_files" | sed 's/^/  /'
  status=1
fi

# 2. Added lines that look like credentials.
#    key = value / key: value where the key names a secret and the value is
#    not an obvious placeholder; private keys; common cloud and AI key formats.
secret_kv='(password|passwd|secret|api[_-]?key|access[_-]?key|auth[_-]?token|private[_-]?key)[a-z0-9_]*["'\'']?[[:space:]]*[:=][[:space:]]*["'\'']?[^[:space:]"'\'']{6,}'
known_formats='-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|sk-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{30,}|xox[abp]-[A-Za-z0-9-]{10,}'
# Values read from the environment or config are fine, so are placeholders.
placeholders='CHANGE_ME|<[^>]*>|\$\{[^}]*\}|\$[A-Z_]+|environ|getenv|process\.env|Environment\.|config\[|settings\.|your[_-]|example|placeholder|dummy|xxxx|\*\*\*\*'

# The hook itself is skipped: its patterns would match themselves.
hits=$(git diff --cached -U0 --no-color --diff-filter=ACMR -- . ':(exclude,glob)**/hooks/pre-commit' \
  | grep -E '^\+' | grep -vE '^\+\+\+ ' \
  | grep -iE "$secret_kv|$known_formats" \
  | grep -viE "$placeholders" || true)
if [ -n "$hits" ]; then
  echo "Secret check: possible credential(s) in staged lines:"
  echo "$hits" | cut -c1-120 | sed 's/^/  /'
  status=1
fi

if [ "$status" -ne 0 ]; then
  echo "Move real values to .env (git-ignored) and use CHANGE_ME in examples."
  echo "If this is a false positive, reword the line or use a placeholder."
fi
exit "$status"
